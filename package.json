{
  "name": "kiln-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:binary": "node scripts/build-binary.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vp test run",
    "test:socket": "vp test run --config vitest.socket.config.ts",
    "test:watch": "vp test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.8.0",
    "vitest": "5.1.1"
  }
}
