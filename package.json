{
  "name": "kiln-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs --mode desktop",
    "dev:desktop": "node scripts/dev.mjs --mode desktop",
    "dev:web": "node scripts/dev.mjs --mode web",
    "build": "pnpm -r --if-present build",
    "build:binary": "node scripts/build-binary.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "test": "vp test run",
    "test:socket": "vp test run --config vitest.socket.config.ts",
    "test:watch": "vp test",
    "qa:sandbox": "node scripts/qa-sandbox.mjs",
    "qa:sync-issues": "node scripts/qa-sync-issues.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.8.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
