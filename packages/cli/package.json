{
  "name": "@zzf2333/kiln",
  "version": "0.0.5",
  "description": "Local-first autonomous developer workbench and kilnd CLI",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zzf2333/Kiln",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzf2333/Kiln.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "mcp/dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "kiln": "./dist/bin.js",
    "kl": "./dist/bin.js",
    "kiln-mcp": "./mcp/dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/stage-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/cli/src"
  },
  "dependencies": {
    "@getpaseo/client": "^0.16.1",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "hono": "^4.7.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@kiln/kernel": "workspace:*",
    "@kiln/mcp": "workspace:*",
    "@kiln/protocol": "workspace:*",
    "@kiln/web": "workspace:*"
  }
}
