{
  "name": "@kiln/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kiln": "./dist/bin.js",
    "kl": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --external better-sqlite3",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/cli/src"
  },
  "dependencies": {
    "@kiln/kernel": "workspace:*",
    "@kiln/protocol": "workspace:*"
  }
}
