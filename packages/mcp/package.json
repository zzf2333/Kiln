{
  "name": "@kiln/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kiln-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/mcp/src"
  },
  "dependencies": {
    "@kiln/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  }
}
