{
  "name": "@kiln/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tauri:dev": "cargo tauri dev --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "cargo tauri build --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:core": "rustc --test src-tauri/src/model.rs -o /tmp/kiln-desktop-model-test && /tmp/kiln-desktop-model-test && rm -f /tmp/kiln-desktop-model-test"
  }
}
