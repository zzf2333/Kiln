{
  "name": "@kiln/desktop",
  "version": "0.0.5",
  "private": true,
  "description": "Kiln desktop workbench (Electron)",
  "author": "Kiln Contributors",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "vp pack && node scripts/stage-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run --root ../.. apps/desktop/src",
    "pack:dir": "electron-builder --dir",
    "pack:mac": "electron-builder --mac dmg",
    "pack:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@kiln/kernel": "workspace:*",
    "@kiln/mcp": "workspace:*",
    "@kiln/protocol": "workspace:*",
    "@kiln/web": "workspace:*",
    "@types/node": "^22.15.0",
    "@zzf2333/kiln": "workspace:*",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
